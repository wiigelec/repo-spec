#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import json
import subprocess
import sys
from pathlib import Path

PRODUCER_ID = "repository-canonical-validator"


def fail(message: str) -> int:
    print(message, file=sys.stderr)
    return 1


def main() -> int:
    try:
        request = json.load(sys.stdin)
    except json.JSONDecodeError:
        return fail("invalid canonical validation request JSON")

    expected = {
        "governing_issue",
        "governed_operation",
        "observed_revision",
        "producer_id",
        "validation_subject",
    }
    if not isinstance(request, dict) or set(request) != expected:
        return fail("invalid canonical validation request fields")
    if request["producer_id"] != PRODUCER_ID:
        return fail("canonical validation producer identity mismatch")

    subject = Path(request["validation_subject"]).resolve()
    if not subject.is_file():
        return fail("canonical validation subject is unavailable")
    revision = hashlib.sha256(subject.read_bytes()).hexdigest()
    if revision != request["observed_revision"]:
        return fail("canonical validation subject revision mismatch")

    repo_root = Path(__file__).resolve().parents[2]
    policy = repo_root / "repo" / "scripts" / "github-field-policy"
    result = subprocess.run(
        [str(policy), "--mode", "issue", "--body-file", str(subject)],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        return fail(f"canonical governed-state field policy failed: {detail}")

    print(json.dumps({
        "governing_issue": request["governing_issue"],
        "governed_operation": request["governed_operation"],
        "validated_revision": revision,
        "validation_artifact_id": f"repository-field-policy:sha256:{revision}",
        "producer_id": PRODUCER_ID,
        "canonical_structure_valid": True,
    }))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
