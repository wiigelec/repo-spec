#!/usr/bin/env python3
from __future__ import annotations

import json
import sys

PRODUCER_ID = "repository-governance-authority"


def fail(message: str) -> int:
    print(message, file=sys.stderr)
    return 1


def main() -> int:
    try:
        request = json.load(sys.stdin)
    except json.JSONDecodeError:
        return fail("invalid repository authorization request JSON")

    expected = {
        "repository",
        "authority_issue",
        "authority_issue_body_sha256",
        "governing_issue",
        "governed_operation",
        "routing_classification",
        "producer_id",
        "lifecycle_authority",
    }
    if not isinstance(request, dict) or set(request) != expected:
        return fail("invalid repository authorization request fields")
    if request["producer_id"] != PRODUCER_ID:
        return fail("repository authorization producer identity mismatch")

    lifecycle = request["lifecycle_authority"]
    if not isinstance(lifecycle, dict):
        return fail("repository lifecycle authority artifact is invalid")

    expected_lifecycle = {
        "authority_issue",
        "governing_issue",
        "governed_operation",
        "routing_classification",
        "authority_path",
        "lifecycle_artifact_id",
        "status",
    }
    if set(lifecycle) != expected_lifecycle:
        return fail("repository lifecycle authority artifact fields are invalid")
    if lifecycle["status"] != "accepted":
        return fail("repository lifecycle authority is not accepted")
    if lifecycle["authority_issue"] != request["authority_issue"]:
        return fail("repository lifecycle authority issue mismatch")
    if lifecycle["governing_issue"] != request["governing_issue"]:
        return fail("repository lifecycle governing issue mismatch")
    if lifecycle["governed_operation"] != request["governed_operation"]:
        return fail("repository lifecycle governed operation mismatch")
    if lifecycle["routing_classification"] != request["routing_classification"]:
        return fail("repository lifecycle routing classification mismatch")

    classification = request["routing_classification"]
    expected_path = (
        "audit" if classification == "bug-fix"
        else "feature-development" if classification == "feature-request"
        else None
    )
    if expected_path is None:
        return fail("unsupported repository routing classification")
    if lifecycle["authority_path"] != expected_path:
        return fail("repository lifecycle authority path mismatch")

    artifact_id = lifecycle["lifecycle_artifact_id"]
    if not isinstance(artifact_id, str) or not artifact_id.strip():
        return fail("repository lifecycle artifact identity missing")

    print(json.dumps({
        "authority_issue": request["authority_issue"],
        "governing_issue": request["governing_issue"],
        "governed_operation": request["governed_operation"],
        "routing_classification": classification,
        "authority_path": expected_path,
        "lifecycle_artifact_id": artifact_id.strip(),
        "producer_id": PRODUCER_ID,
    }))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
