{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo/schemas/repo-platform-profiles.schema.json",
  "title": "Platform Profiles Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_id",
    "title",
    "purpose",
    "status",
    "schema_version",
    "profiles",
    "normative_requirements",
    "dependencies",
    "references",
    "derived_artifacts"
  ],
  "properties": {
    "spec_id": {
      "type": "string",
      "const": "repo.platform-profiles"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "accepted",
        "superseded",
        "retired"
      ]
    },
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "normative_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "derived_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derivedArtifact"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "label",
        "source_root",
        "installed_adapter_root",
        "authority_boundary",
        "adapter_generation_policy",
        "artifact_inventory",
        "deployment_state",
        "remote_state_kinds",
        "mutation_record_fields"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "const": "github"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "source_root": {
          "type": "string",
          "const": "repo/profiles/github/"
        },
        "installed_adapter_root": {
          "type": "string",
          "const": ".github/"
        },
        "authority_boundary": {
          "type": "string",
          "enum": [
            "profile-source-authoritative"
          ]
        },
        "adapter_generation_policy": {
          "type": "string",
          "enum": [
            "source-to-adapter"
          ]
        },
        "artifact_inventory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactInventoryItem"
          }
        },
        "deployment_state": {
          "$ref": "#/$defs/deploymentState"
        },
        "remote_state_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "branch protection",
              "repository rulesets",
              "required checks",
              "merge queues",
              "labels",
              "repository settings"
            ]
          }
        },
        "mutation_record_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifactInventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "classification",
        "authority_category",
        "profile_id"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
        },
        "classification": {
          "type": "string",
          "enum": [
            "installed-adapter",
            "bootstrap-infrastructure"
          ]
        },
        "authority_category": {
          "type": "string",
          "enum": [
            "profile-specific",
            "implementation"
          ]
        },
        "profile_id": {
          "type": "string",
          "const": "github"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "const": "installed-adapter"
              }
            }
          },
          "then": {
            "properties": {
              "authority_category": {
                "const": "profile-specific"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "bootstrap-infrastructure"
              }
            }
          },
          "then": {
            "properties": {
              "authority_category": {
                "const": "implementation"
              }
            }
          }
        }
      ]
    },
    "deploymentState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleset_desired_state_format",
        "branch_protection_desired_state_format",
        "inspection_procedure",
        "plan_apply_separation",
        "mutation_evidence_record_fields",
        "rollback_and_post_change_verification"
      ],
      "properties": {
        "ruleset_desired_state_format": {
          "$ref": "#/$defs/desiredStateFormat"
        },
        "branch_protection_desired_state_format": {
          "$ref": "#/$defs/desiredStateFormat"
        },
        "inspection_procedure": {
          "$ref": "#/$defs/stringList"
        },
        "plan_apply_separation": {
          "$ref": "#/$defs/stringList"
        },
        "mutation_evidence_record_fields": {
          "$ref": "#/$defs/stringList"
        },
        "rollback_and_post_change_verification": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "desiredStateFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_fields"
      ],
      "properties": {
        "required_fields": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_id"
      ],
      "properties": {
        "spec_id": {
          "type": "string",
          "pattern": "^repo\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
        }
      }
    },
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "spec_id"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "specification"
            },
            "kind": {
              "type": "string",
              "enum": [
                "normative",
                "historical"
              ]
            },
            "spec_id": {
              "type": "string",
              "pattern": "^repo\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "artifact"
            },
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$",
              "minLength": 1
            }
          }
        }
      ]
    },
    "derivedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "markdown"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$",
          "minLength": 1
        }
      }
    }
  }
}
