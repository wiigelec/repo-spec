            }
          }
        }
      ]
    },
    "schemaArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactClass"
        },
        {
          "properties": {
            "identifier": {
              "const": "schema"
            },
            "role": {
              "const": "schema"
            },
            "authority_category": {
              "const": "normative"
            },
            "generation_mode": {
              "const": "manual"
            },
            "validation_ownership": {
              "const": "validation"
            },
            "portability_category": {
              "const": "framework-generic"
            },
            "manifest_participation": {
              "const": "reference"
            }
          }
        }
      ]
    },
    "manifestIndex": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactClass"
        },
        {
          "properties": {
            "identifier": {
              "const": "manifest-index"
            },
            "role": {
              "const": "manifest or index"
            },
            "authority_category": {
              "const": "normative"
            },
            "generation_mode": {
              "const": "manual"
            },
            "validation_ownership": {
              "const": "validation"
            },
            "portability_category": {
              "const": "framework-generic"
            },
            "manifest_participation": {
              "const": "authoritative"
            }
          }
        }
      ]
    },
    "derivedProjection": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactClass"
        },
        {
          "required": [
            "source_artifacts"
          ],
          "properties": {
            "identifier": {
              "const": "derived-projection"
            },
            "role": {
              "const": "derived projection"
            },
            "authority_category": {
              "const": "generated"
