{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo/schemas/repo-artifact-taxonomy.schema.json",
  "title": "Framework Artifact Taxonomy Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_id",
    "title",
    "purpose",
    "status",
    "schema_version",
    "artifact_classes",
    "normative_requirements",
    "dependencies",
    "references",
    "derived_artifacts"
  ],
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^repo\\.artifact-taxonomy$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "accepted",
        "superseded",
        "retired"
      ]
    },
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "artifact_classes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/discoveryRecord"
          },
          {
            "$ref": "#/$defs/overviewWhiteboard"
          },
          {
            "$ref": "#/$defs/overviewAnalysis"
          },
          {
            "$ref": "#/$defs/functionalSet"
          },
          {
            "$ref": "#/$defs/productDecomposition"
          },
          {
            "$ref": "#/$defs/implementationPlan"
          },
          {
            "$ref": "#/$defs/repositorySpecification"
          },
          {
            "$ref": "#/$defs/productSpecification"
          },
          {
            "$ref": "#/$defs/schemaArtifact"
          },
          {
            "$ref": "#/$defs/manifestIndex"
          },
          {
            "$ref": "#/$defs/derivedProjection"
          },
          {
            "$ref": "#/$defs/productArtifact"
          },
          {
            "$ref": "#/$defs/testArtifact"
          },
          {
            "$ref": "#/$defs/conformanceArtifact"
          },
          {
            "$ref": "#/$defs/hostingPlatformProfile"
          },
          {
            "$ref": "#/$defs/hostingProfileSource"
          },
          {
            "$ref": "#/$defs/installedHostingAdapter"
          },
          {
            "$ref": "#/$defs/hostingDeploymentState"
          },
          {
            "$ref": "#/$defs/bootstrapHostingInfrastructure"
          },
          {
            "$ref": "#/$defs/validationEvidence"
          },
          {
            "$ref": "#/$defs/reviewRecord"
          },
          {
            "$ref": "#/$defs/acceptanceRecord"
          },
          {
            "$ref": "#/$defs/releaseRecord"
          },
          {
            "$ref": "#/$defs/userConvenience"
          }
        ]
      }
    },
    "normative_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "derived_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derivedArtifact"
      }
    }
  },
  "$defs": {
    "artifactClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "label",
        "role",
        "authority_category",
        "authority_source",
        "source_of_truth_rule",
        "mutability",
        "generation_mode",
        "validation_ownership",
        "portability_category",
        "manifest_participation"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "enum": [
            "discovery-record",
            "overview-whiteboard",
            "overview-analysis",
            "functional-set",
            "product-decomposition",
            "implementation-plan",
            "repository-specification",
            "product-specification",
            "schema",
            "manifest-index",
            "derived-projection",
            "product-artifact",
            "test-artifact",
            "conformance-artifact",
            "hosting-platform-profile",
            "hosting-profile-source",
            "installed-hosting-adapter",
            "hosting-deployment-state",
            "bootstrap-hosting-infrastructure",
            "validation-evidence",
            "review-record",
            "acceptance-record",
            "release-record",
            "user-convenience"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "discovery record",
            "collection evidence",
            "analysis synthesis",
            "functional-set handoff",
            "decomposition",
            "plan",
            "repository specification",
            "product specification",
            "schema",
            "manifest or index",
            "derived projection",
            "product artifact",
            "test artifact",
            "conformance artifact",
            "platform profile",
            "profile source",
            "installed adapter",
            "hosting deployment state",
            "bootstrap infrastructure",
            "validation evidence",
            "review record",
            "acceptance record",
            "release record",
            "user convenience"
          ]
        },
        "authority_category": {
          "type": "string",
          "enum": [
            "directional",
            "planning",
            "normative",
            "generated",
            "implementation",
            "evidentiary",
            "review",
            "acceptance",
            "release",
            "profile-specific",
            "convenience"
          ]
        },
        "authority_source": {
          "type": "string",
          "minLength": 1
        },
        "source_of_truth_rule": {
          "type": "string",
          "minLength": 1
        },
        "mutability": {
          "type": "string",
          "minLength": 1
        },
        "generation_mode": {
          "type": "string",
          "enum": [
            "manual",
            "deterministic",
            "external"
          ]
        },
        "validation_ownership": {
          "type": "string",
          "enum": [
            "review",
            "validation",
            "product",
            "platform",
            "release"
          ]
        },
        "portability_category": {
          "type": "string",
          "enum": [
            "framework-generic",
            "product-specific",
            "profile-specific"
          ]
        },
        "manifest_participation": {
          "type": "string",
          "enum": [
            "none",
            "authoritative",
            "derived",
            "reference"
          ]
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_id"
      ],
      "properties": {
        "spec_id": {
          "type": "string",
          "pattern": "^repo\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
        }
      }
    },
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "spec_id"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "specification"
            },
            "kind": {
              "type": "string",
              "enum": [
                "normative",
                "historical"
              ]
            },
            "spec_id": {
              "type": "string",
              "pattern": "^repo\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "artifact"
            },
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$",
              "minLength": 1
            }
          }
        }
      ]
    },
    "derivedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "markdown"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$",
          "minLength": 1
        }
      }
    },
    "discoveryRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactClass"
        },
        {
          "properties": {
            "identifier": {
              "const": "discovery-record"
            },
            "role": {
              "const": "discovery record"
            },
            "authority_category": {
              "const": "directional"
            },
            "generation_mode": {
              "const": "manual"
            },
            "validation_ownership": {
              "const": "review"
            },
            "portability_category": {
              "const": "framework-generic"
            },
            "manifest_participation": {
              "const": "none"
            }
          }
        }
      ]
    },
    "productDecomposition": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactClass"
        },
        {
          "properties": {
            "identifier": {
              "const": "product-decomposition"
