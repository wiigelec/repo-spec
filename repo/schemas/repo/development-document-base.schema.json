{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo/schemas/repo/development-document-base.schema.json",
  "title": "Development Document Base Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type",
    "document_slug",
    "filename_stem",
    "root_path",
    "title",
    "product_id",
    "authority_category",
    "lifecycle_status",
    "governing_issue",
    "controlling_documents",
    "predecessor_documents",
    "evidence",
    "subordinate_chunks",
    "successor_action",
    "schema_version"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "overview-whiteboard",
        "overview-analysis",
        "functional-set",
        "product-decomposition",
        "implementation-plan",
        "architecture-plan"
      ]
    },
    "document_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "filename_stem": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "root_path": {
      "type": "string",
      "enum": [
        "repo/docs/overview/",
        "repo/docs/decompositions/",
        "repo/docs/plans/",
        "product/docs/overview/",
        "product/docs/decompositions/",
        "product/docs/plans/",
        "repo/docs/architecture/"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_category": {
      "type": "string",
      "enum": [
        "evidentiary",
        "directional",
        "planning"
      ]
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "active",
        "candidate",
        "approved",
        "accepted",
        "superseded",
        "retired"
      ]
    },
    "governing_issue": {
      "type": "string",
      "minLength": 1
    },
    "required_content_areas": {
      "type": "object"
    },
    "controlling_documents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
      }
    },
    "predecessor_documents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
      }
    },
    "workstream_authority": {
      "type": "array"
    },
    "subordinate_chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chunk"
      }
    },
    "successor_action": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "const": "1"
    }
  },
  "allOf": [],
  "$defs": {
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "path",
        "title"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.md$",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "document_coverage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "area_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
        }
      }
    }
  }
}
