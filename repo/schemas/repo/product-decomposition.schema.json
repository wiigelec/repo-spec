{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo/schemas/repo/product-decomposition.schema.json",
  "title": "Product Decomposition Document Schema",
  "allOf": [
    {
      "$ref": "./development-document-base.schema.json"
    },
    {
      "type": "object",
      "required": [
        "artifact_type",
        "root_path",
        "required_content_areas"
      ],
      "properties": {
        "artifact_type": {
          "type": "string",
          "const": "product-decomposition"
        },
        "root_path": {
          "type": "string",
          "enum": ["repo/docs/decompositions/", "product/docs/decompositions/"]
        },
        "required_content_areas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decomposition_basis",
            "product_area_inventory",
            "dependency_model",
            "cross_cutting_concerns",
            "unresolved_decisions",
            "stopping_criteria",
            "planning_handoff"
          ],
          "properties": {
            "decomposition_basis": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.md$"
              }
            },
            "product_area_inventory": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.md$"
              }
            },
            "dependency_model": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.md$"
              }
            },
            "cross_cutting_concerns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.md$"
              }
            },
            "unresolved_decisions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.md$"
              }
            },
            "stopping_criteria": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.md$"
              }
            },
            "planning_handoff": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.md$"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "subordinate_chunks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["order", "path", "title", "role"],
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "product-area",
                  "decomposition-basis",
                  "cross-cutting-concerns",
                  "dependency-model",
                  "unresolved-decisions",
                  "stopping-and-handoff"
                ]
              },
              "area_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
              },
              "coverage": {
                "type": "array",
                "minItems": 7,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "purpose",
                    "responsibilities",
                    "boundaries",
                    "dependencies",
                    "exclusions",
                    "unresolved-decisions",
                    "successor-work"
                  ]
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "role": {
                      "const": "product-area"
                    }
                  },
                  "required": ["role"]
                },
                "then": {
                  "required": ["area_id", "coverage"]
                }
              }
            ]
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
