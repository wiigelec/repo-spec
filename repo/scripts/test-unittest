#!/usr/bin/env bash

set -euo pipefail

root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)


if (($#)); then
    exec env PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$root/repo/src:$root/repo${PYTHONPATH:+:$PYTHONPATH}" python3 -P -m unittest "$@"
fi

exec env PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$root/repo/src:$root/repo${PYTHONPATH:+:$PYTHONPATH}" python3 -P -m unittest discover -s "$root/repo/validation/tests/unit" -t "$root/repo"
