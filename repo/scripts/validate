#!/usr/bin/env bash

set -euo pipefail

root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)

if [[ $# -gt 0 ]]; then
    echo "validation error: unknown argument: ${1}" >&2
    exit 1
fi

env PYTHONDONTWRITEBYTECODE=1 python3 "$root/repo/scripts/root_validation.py" "$root"

if [[ ! -d "$root/reference" ]]; then
    exit 0
fi

exec env PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$root/repo/scripts${PYTHONPATH:+:$PYTHONPATH}" python3 "$root/repo/scripts/validate_impl.py" "$root"
