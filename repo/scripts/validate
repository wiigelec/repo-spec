#!/usr/bin/env bash

set -euo pipefail

root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)

if [[ $# -gt 0 ]]; then
    echo "validation error: unknown argument: ${1}" >&2
    exit 1
fi



exec env PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$root/repo:$root/repo/scripts${PYTHONPATH:+:$PYTHONPATH}" python3 "$root/repo/validation/runners/validate_impl.py" "$root"
