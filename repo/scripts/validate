#!/usr/bin/env bash

set -euo pipefail

root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
repo_tree_sha=${1-}

if [[ $# -gt 1 ]]; then
    echo "validation error: unknown argument: ${2}" >&2
    exit 1
fi

env PYTHONDONTWRITEBYTECODE=1 python3 "$root/repo/scripts/root_validation.py" "$root" "$repo_tree_sha"

if [[ -n "$repo_tree_sha" ]]; then
    exit 0
fi

exec env PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$root/repo/scripts${PYTHONPATH:+:$PYTHONPATH}" python3 "$root/repo/scripts/validate_impl.py" "$root"
