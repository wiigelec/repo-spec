#!/usr/bin/env bash

set -euo pipefail

root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
mode=${1:---write}

exec env PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$root/repo/scripts:$root/product/scripts${PYTHONPATH:+:$PYTHONPATH}" python3 "$root/repo/scripts/docgen.py" "$root" "$mode"
