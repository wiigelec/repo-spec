{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/repo/product-decomposition.schema.json",
  "title": "Product Decomposition Document Schema",
  "allOf": [
    {
      "$ref": "./development-document-base.schema.json"
    },
    {
      "type": "object",
      "required": [
        "artifact_type",
        "root_path",
        "content_areas"
      ],
      "properties": {
        "artifact_type": {
          "type": "string",
          "const": "product-decomposition"
        },
        "root_path": {
          "type": "string",
          "const": "docs/decompositions/"
        }
      }
    }
    ,
    {
      "type": "object",
      "properties": {
        "subordinate_chunks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["order", "path", "title", "role", "area_id"],
            "properties": {
              "role": {
                "type": "string",
                "const": "product-area"
              },
              "area_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
