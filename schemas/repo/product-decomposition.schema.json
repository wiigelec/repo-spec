{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/repo/product-decomposition.schema.json",
  "title": "Product Decomposition Document Schema",
  "allOf": [
    {
      "$ref": "./development-document-base.schema.json"
    },
    {
      "type": "object",
      "required": [
        "artifact_type",
        "root_path",
        "content_areas"
      ],
      "properties": {
        "artifact_type": {
          "type": "string",
          "const": "product-decomposition"
        },
        "root_path": {
          "type": "string",
          "const": "docs/decompositions/"
        },
        "content_areas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "invocation_and_authority",
            "framework_and_product_foundations",
            "platform_and_execution",
            "generation_validation_and_handoff"
          ],
          "properties": {
            "invocation_and_authority": {
              "type": "string"
            },
            "framework_and_product_foundations": {
              "type": "string"
            },
            "platform_and_execution": {
              "type": "string"
            },
            "generation_validation_and_handoff": {
              "type": "string"
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
