{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/repo/implementation-plan.schema.json",
  "title": "Implementation Plan Document Schema",
  "allOf": [
    {
      "$ref": "./development-document-base.schema.json"
    },
    {
      "type": "object",
      "required": [
        "artifact_type",
        "root_path",
        "required_content_areas"
      ],
      "properties": {
        "artifact_type": {
          "type": "string",
          "const": "implementation-plan"
        },
        "root_path": {
          "type": "string",
          "const": "docs/plans/"
        },
        "required_content_areas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope_and_preconditions",
            "workstreams_and_dependencies",
            "validation_and_completion"
          ],
          "properties": {
            "scope_and_preconditions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.md$"
              }
            },
            "workstreams_and_dependencies": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.md$"
              }
            },
            "validation_and_completion": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.md$"
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
