{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/repo/development-document-base.schema.json",
  "title": "Development Document Base Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type",
    "document_slug",
    "filename_stem",
    "root_path",
    "title",
    "product_id",
    "authority_category",
    "lifecycle_status",
    "governing_issue",
    "controlling_documents",
    "predecessor_documents",
    "evidence",
    "subordinate_chunks",
    "successor_action",
    "schema_version"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
    },
    "artifact_type": {
      "type": "string",
      "enum": ["product-overview", "product-decomposition", "implementation-plan"]
    },
    "document_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "filename_stem": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "root_path": {
      "type": "string",
      "enum": ["docs/overview/", "docs/decompositions/", "docs/plans/"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_category": {
      "type": "string",
      "enum": ["directional", "planning"]
    },
    "lifecycle_status": {
      "type": "string",
      "enum": ["candidate", "accepted", "superseded", "retired"]
    },
    "governing_issue": {
      "type": "string",
      "minLength": 1
    },
    "required_content_areas": {
      "type": "object"
    },
    "controlling_documents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
      }
    },
    "predecessor_documents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
      }
    },
    "overview_role": {
      "type": "string",
      "enum": ["initial", "revision", "replacement", "branch"]
    },
    "subordinate_chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chunk"
      }
    },
    "successor_action": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "const": "1"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "product-overview"
          }
        },
        "required": ["artifact_type"]
      },
      "then": {
        "required": ["overview_role"]
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "product-overview"
          },
          "overview_role": {
            "const": "initial"
          }
        },
        "required": ["artifact_type", "overview_role"]
      },
      "then": {
        "properties": {
          "controlling_documents": {
            "minItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "controlling_documents": {
            "minItems": 1
          },
          "predecessor_documents": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "path", "title"],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.md$",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "document_coverage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "area_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
        }
      }
    }
  }
}
