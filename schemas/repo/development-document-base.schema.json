{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/repo/development-document-base.schema.json",
  "title": "Development Document Base Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type",
    "document_slug",
    "root_path",
    "title",
    "product_id",
    "authority_category",
    "lifecycle_status",
    "governing_issue",
    "basis",
    "content_areas",
    "subordinate_chunks",
    "successor_action",
    "schema_version"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "artifact_type": {
      "type": "string",
      "enum": ["product-overview", "product-decomposition", "implementation-plan"]
    },
    "document_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "root_path": {
      "type": "string",
      "enum": ["docs/overview/", "docs/decompositions/", "docs/plans/"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_category": {
      "type": "string",
      "enum": ["directional", "planning"]
    },
    "lifecycle_status": {
      "type": "string",
      "enum": ["candidate", "accepted", "superseded", "retired"]
    },
    "governing_issue": {
      "type": "string",
      "minLength": 1
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "content_areas": {
      "type": "object"
    },
    "subordinate_chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chunk"
      }
    },
    "successor_action": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "const": "1"
    }
  },
  "$defs": {
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "spec_id"],
          "properties": {
            "type": {
              "type": "string",
              "const": "specification"
            },
            "kind": {
              "type": "string",
              "enum": ["normative", "historical"]
            },
            "spec_id": {
              "type": "string",
              "pattern": "^repo\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": {
              "type": "string",
              "const": "artifact"
            },
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$",
              "minLength": 1
            }
          }
        }
      ]
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "path", "title"],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.md$",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
