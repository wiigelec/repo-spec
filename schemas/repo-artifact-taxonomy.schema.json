{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/repo-artifact-taxonomy.schema.json",
  "title": "Framework Artifact Taxonomy Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_id",
    "title",
    "purpose",
    "status",
    "schema_version",
    "artifact_classes",
    "normative_requirements",
    "dependencies",
    "references",
    "derived_artifacts"
  ],
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^repo\\.artifact-taxonomy$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["candidate", "accepted", "superseded", "retired"]
    },
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "artifact_classes": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/discoveryRecord" },
          { "$ref": "#/$defs/productOverview" },
          { "$ref": "#/$defs/implementationPlan" },
          { "$ref": "#/$defs/repositorySpecification" },
          { "$ref": "#/$defs/productSpecification" },
          { "$ref": "#/$defs/schemaArtifact" },
          { "$ref": "#/$defs/manifestIndex" },
          { "$ref": "#/$defs/derivedProjection" },
          { "$ref": "#/$defs/productArtifact" },
          { "$ref": "#/$defs/testArtifact" },
          { "$ref": "#/$defs/conformanceArtifact" },
          { "$ref": "#/$defs/hostingPlatformProfile" },
          { "$ref": "#/$defs/validationEvidence" },
          { "$ref": "#/$defs/reviewRecord" },
          { "$ref": "#/$defs/acceptanceRecord" },
          { "$ref": "#/$defs/releaseRecord" }
        ]
      }
    },
    "normative_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "references": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" }
    },
    "derived_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/derivedArtifact" }
    }
  },
  "$defs": {
    "artifactClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "label",
        "role",
        "authority_category",
        "authority_source",
        "source_of_truth_rule",
        "mutability",
        "generation_mode",
        "validation_ownership",
        "portability_category",
        "manifest_participation"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "enum": [
            "discovery-record",
            "product-overview",
            "implementation-plan",
            "repository-specification",
            "product-specification",
            "schema",
            "manifest-index",
            "derived-projection",
            "product-artifact",
            "test-artifact",
            "conformance-artifact",
            "hosting-platform-profile",
            "validation-evidence",
            "review-record",
            "acceptance-record",
            "release-record"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "discovery record",
            "overview",
            "plan",
            "repository specification",
            "product specification",
            "schema",
            "manifest or index",
            "derived projection",
            "product artifact",
            "test artifact",
            "conformance artifact",
            "platform profile",
            "validation evidence",
            "review record",
            "acceptance record",
            "release record"
          ]
        },
        "authority_category": {
          "type": "string",
          "enum": [
            "directional",
            "planning",
            "normative",
            "generated",
            "implementation",
            "evidentiary",
            "review",
            "acceptance",
            "release",
            "profile-specific"
          ]
        },
        "authority_source": {
          "type": "string",
          "minLength": 1
        },
        "source_of_truth_rule": {
          "type": "string",
          "minLength": 1
        },
        "mutability": {
          "type": "string",
          "minLength": 1
        },
        "generation_mode": {
          "type": "string",
          "enum": ["manual", "deterministic", "external"]
        },
        "validation_ownership": {
          "type": "string",
          "enum": ["review", "validation", "product", "platform", "release"]
        },
        "portability_category": {
          "type": "string",
          "enum": ["framework-generic", "product-specific", "profile-specific"]
        },
        "manifest_participation": {
          "type": "string",
          "enum": ["none", "authoritative", "derived", "reference"]
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_id"],
      "properties": {
        "spec_id": {
          "type": "string",
          "pattern": "^repo\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
        }
      }
    },
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "spec_id"],
          "properties": {
            "type": {
              "type": "string",
              "const": "specification"
            },
            "kind": {
              "type": "string",
              "enum": ["normative", "historical"]
            },
            "spec_id": {
              "type": "string",
              "pattern": "^repo\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": {
              "type": "string",
              "const": "artifact"
            },
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$",
              "minLength": 1
            }
          }
        }
      ]
    },
    "derivedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["markdown"]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$",
          "minLength": 1
        }
      }
    },
    "discoveryRecord": {
      "allOf": [
        { "$ref": "#/$defs/artifactClass" },
        {
          "properties": {
            "identifier": { "const": "discovery-record" },
            "role": { "const": "discovery record" },
            "authority_category": { "const": "directional" },
            "generation_mode": { "const": "manual" },
            "validation_ownership": { "const": "review" },
            "portability_category": { "const": "framework-generic" },
            "manifest_participation": { "const": "none" }
          }
        }
      ]
    },
    "productOverview": {
      "allOf": [
        { "$ref": "#/$defs/artifactClass" },
        {
          "properties": {
            "identifier": { "const": "product-overview" },
            "role": { "const": "overview" },
            "authority_category": { "const": "directional" },
            "generation_mode": { "const": "manual" },
            "validation_ownership": { "const": "review" },
            "portability_category": { "const": "framework-generic" },
            "manifest_participation": { "const": "none" }
          }
        }
      ]
    },
    "implementationPlan": {
      "allOf": [
        { "$ref": "#/$defs/artifactClass" },
        {
          "properties": {
            "identifier": { "const": "implementation-plan" },
            "role": { "const": "plan" },
            "authority_category": { "const": "planning" },
            "generation_mode": { "const": "manual" },
            "validation_ownership": { "const": "review" },
            "portability_category": { "const": "framework-generic" },
            "manifest_participation": { "const": "none" }
          }
        }
      ]
    },
    "repositorySpecification": {
      "allOf": [
        { "$ref": "#/$defs/artifactClass" },
        {
          "properties": {
            "identifier": { "const": "repository-specification" },
            "role": { "const": "repository specification" },
            "authority_category": { "const": "normative" },
            "generation_mode": { "const": "manual" },
            "validation_ownership": { "const": "validation" },
            "portability_category": { "const": "framework-generic" },
            "manifest_participation": { "const": "authoritative" }
          }
        }
      ]
    },
    "productSpecification": {
      "allOf": [
        { "$ref": "#/$defs/artifactClass" },
        {
          "properties": {
            "identifier": { "const": "product-specification" },
            "role": { "const": "product specification" },
            "authority_category": { "const": "normative" },
            "generation_mode": { "const": "manual" },
            "validation_ownership": { "const": "validation" },
            "portability_category": { "const": "product-specific" },
            "manifest_participation": { "const": "authoritative" }
          }
        }
      ]
    },
    "schemaArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifactClass" },
        {
          "properties": {
            "identifier": { "const": "schema" },
            "role": { "const": "schema" },
            "authority_category": { "const": "normative" },
            "generation_mode": { "const": "manual" },
            "validation_ownership": { "const": "validation" },
            "portability_category": { "const": "framework-generic" },
            "manifest_participation": { "const": "reference" }
          }
        }
      ]
    },
    "manifestIndex": {
      "allOf": [
        { "$ref": "#/$defs/artifactClass" },
        {
          "properties": {
            "identifier": { "const": "manifest-index" },
            "role": { "const": "manifest or index" },
            "authority_category": { "const": "normative" },
            "generation_mode": { "const": "manual" },
            "validation_ownership": { "const": "validation" },
            "portability_category": { "const": "framework-generic" },
            "manifest_participation": { "const": "authoritative" }
          }
        }
      ]
    },
    "derivedProjection": {
      "allOf": [
        { "$ref": "#/$defs/artifactClass" },
        {
          "required": ["source_artifacts"],
          "properties": {
            "identifier": { "const": "derived-projection" },
            "role": { "const": "derived projection" },
            "authority_category": { "const": "generated" },
            "generation_mode": { "const": "deterministic" },
            "validation_ownership": { "const": "validation" },
            "portability_category": { "const": "framework-generic" },
            "manifest_participation": { "const": "derived" }
          }
        }
      ]
    },
    "productArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifactClass" },
        {
          "properties": {
            "identifier": { "const": "product-artifact" },
            "role": { "const": "product artifact" },
            "authority_category": { "const": "implementation" },
            "generation_mode": { "const": "manual" },
            "validation_ownership": { "const": "product" },
            "portability_category": { "const": "product-specific" },
            "manifest_participation": { "const": "reference" }
          }
        }
      ]
    },
    "testArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifactClass" },
        {
          "properties": {
            "identifier": { "const": "test-artifact" },
            "role": { "const": "test artifact" },
            "authority_category": { "const": "implementation" },
            "generation_mode": { "const": "manual" },
            "validation_ownership": { "const": "validation" },
            "portability_category": { "const": "product-specific" },
            "manifest_participation": { "const": "reference" }
          }
        }
      ]
    },
    "conformanceArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifactClass" },
        {
          "properties": {
            "identifier": { "const": "conformance-artifact" },
            "role": { "const": "conformance artifact" },
            "authority_category": { "const": "evidentiary" },
            "generation_mode": { "const": "manual" },
            "validation_ownership": { "const": "validation" },
            "portability_category": { "const": "product-specific" },
            "manifest_participation": { "const": "reference" }
          }
        }
      ]
    },
    "hostingPlatformProfile": {
      "allOf": [
        { "$ref": "#/$defs/artifactClass" },
        {
          "properties": {
            "identifier": { "const": "hosting-platform-profile" },
            "role": { "const": "platform profile" },
            "authority_category": { "const": "profile-specific" },
            "generation_mode": { "const": "manual" },
            "validation_ownership": { "const": "platform" },
            "portability_category": { "const": "profile-specific" },
            "manifest_participation": { "const": "reference" }
          }
        }
      ]
    },
    "validationEvidence": {
      "allOf": [
        { "$ref": "#/$defs/artifactClass" },
        {
          "required": ["source_artifacts"],
          "properties": {
            "identifier": { "const": "validation-evidence" },
            "role": { "const": "validation evidence" },
            "authority_category": { "const": "evidentiary" },
            "generation_mode": { "const": "deterministic" },
            "validation_ownership": { "const": "validation" },
            "portability_category": { "const": "framework-generic" },
            "manifest_participation": { "const": "reference" }
          }
        }
      ]
    },
    "reviewRecord": {
      "allOf": [
        { "$ref": "#/$defs/artifactClass" },
        {
          "properties": {
            "identifier": { "const": "review-record" },
            "role": { "const": "review record" },
            "authority_category": { "const": "review" },
            "generation_mode": { "const": "manual" },
            "validation_ownership": { "const": "review" },
            "portability_category": { "const": "framework-generic" },
            "manifest_participation": { "const": "reference" }
          }
        }
      ]
    },
    "acceptanceRecord": {
      "allOf": [
        { "$ref": "#/$defs/artifactClass" },
        {
          "properties": {
            "identifier": { "const": "acceptance-record" },
            "role": { "const": "acceptance record" },
            "authority_category": { "const": "acceptance" },
            "generation_mode": { "const": "manual" },
            "validation_ownership": { "const": "review" },
            "portability_category": { "const": "framework-generic" },
            "manifest_participation": { "const": "reference" }
          }
        }
      ]
    },
    "releaseRecord": {
      "allOf": [
        { "$ref": "#/$defs/artifactClass" },
        {
          "properties": {
            "identifier": { "const": "release-record" },
            "role": { "const": "release record" },
            "authority_category": { "const": "release" },
            "generation_mode": { "const": "manual" },
            "validation_ownership": { "const": "release" },
            "portability_category": { "const": "product-specific" },
            "manifest_participation": { "const": "reference" }
          }
        }
      ]
    }
  }
}
