{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/product/product-level-1.schema.json",
  "title": "Product Level 1 Schema",
  "allOf": [
    {
      "$ref": "./product-spec-base.schema.json"
    },
    {
      "type": "object",
      "required": ["level", "primitives"],
      "properties": {
        "level": {
          "type": "integer",
          "const": 1
        },
        "primitives": {
          "type": "object",
          "additionalProperties": false,
          "required": ["concepts"],
          "properties": {
            "concepts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
