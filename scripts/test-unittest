#!/usr/bin/env bash

set -euo pipefail

root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
pythonpath="$root:$root/repo/src${PYTHONPATH:+:$PYTHONPATH}"

if (($#)); then
    exec env PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$pythonpath" \
        python3 -m unittest "$@"
fi

exec env PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$pythonpath" \
    python3 -m unittest discover \
        -s "$root/validation/tests/unit" \
        -p 'test_*.py'
