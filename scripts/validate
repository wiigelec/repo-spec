#!/usr/bin/env bash

set -u

script_path=${BASH_SOURCE[0]}
case $script_path in
  */*) script_dir=${script_path%/*} ;;
  *) script_dir=. ;;
esac
repo_root=$(cd -- "$script_dir/.." && pwd)

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

has_file() {
  [[ -e $repo_root/$1 ]]
}

check_required_file() {
  local path=$1
  has_file "$path" || {
    printf 'missing required bootstrap file: %s\n' "$path" >&2
    return 1
  }
}

check_required_files() {
  local path
  for path in \
    README.md \
    docs/overview/PRODUCT-OVERVIEW.md \
    docs/plans/00-bootstrap-plan.md \
    schemas/repo-spec.schema.json \
    schemas/repo-manifest.schema.json \
    specs/repo/json-artifact-model.md \
    specs/repo/manifest.json \
    specs/repo/repository-structure.json \
    specs/repo/development-workflow.json \
    specs/repo/validation.json \
    derived/specs/repo/manifest.md \
    derived/specs/repo/repository-structure.md \
    derived/specs/repo/development-workflow.md \
    derived/specs/repo/validation.md \
    scripts/validate
  do
    check_required_file "$path" || return 1
  done
}

check_directory_separation() {
  local path
  local -a unexpected=()

  for path in "$repo_root"/docs/*; do
    [[ -e $path ]] || continue
    case ${path##*/} in
      overview|plans) ;;
      *) unexpected+=("${path#$repo_root/}") ;;
    esac
  done

  for path in "$repo_root"/schemas/*; do
    [[ -e $path ]] || continue
    case ${path##*/} in
      repo-spec.schema.json|repo-manifest.schema.json) ;;
      *) unexpected+=("${path#$repo_root/}") ;;
    esac
  done

  for path in "$repo_root"/derived/specs/repo/*; do
    [[ -e $path ]] || continue
    case ${path##*/} in
      manifest.md|repository-structure.md|development-workflow.md|validation.md) ;;
      *) unexpected+=("${path#$repo_root/}") ;;
    esac
  done

  for path in "$repo_root"/specs/repo/*; do
    [[ -e $path ]] || continue
    case ${path##*/} in
      json-artifact-model.md|manifest.json|repository-structure.json|development-workflow.json|validation.json) ;;
      *) unexpected+=("${path#$repo_root/}") ;;
    esac
  done

  [[ ${#unexpected[@]} -eq 0 ]] || {
    printf 'bootstrap directory separation violated\n' >&2
    return 1
  }
}

file_contains() {
  local file=$1
  local needle=$2
  local line

  while IFS= read -r line || [[ -n $line ]]; do
    case $line in
      *"$needle"*) return 0 ;;
    esac
  done < "$repo_root/$file"

  return 1
}

check_relative_links() {
  local link

  for link in \
    '[Product overview](docs/overview/PRODUCT-OVERVIEW.md)' \
    '[Bootstrap plan](docs/plans/00-bootstrap-plan.md)' \
    '[JSON artifact model](specs/repo/json-artifact-model.md)' \
    '[Repository manifest](specs/repo/manifest.json)' \
    '[Repository structure](specs/repo/repository-structure.json)' \
    '[Development workflow](specs/repo/development-workflow.json)' \
    '[Validation](specs/repo/validation.json)' \
    '[Derived repository manifest](derived/specs/repo/manifest.md)' \
    '[Derived repository structure](derived/specs/repo/repository-structure.md)' \
    '[Derived development workflow](derived/specs/repo/development-workflow.md)' \
    '[Derived validation](derived/specs/repo/validation.md)' \
    '[Repo spec schema](schemas/repo-spec.schema.json)' \
    '[Repo manifest schema](schemas/repo-manifest.schema.json)'
  do
    file_contains README.md "$link" || {
      printf 'relative link check failed: README.md\n' >&2
      return 1
    }
  done

  for link in \
    '[1. Product direction](./product-overview/01-product-direction.md)' \
    '[2. Development and specifications](./product-overview/02-development-and-specifications.md)' \
    '[3. Git and change workflow](./product-overview/03-git-and-change-workflow.md)' \
    '[4. Human and AI continuity](./product-overview/04-human-ai-continuity.md)' \
    '[5. Governance and evolution](./product-overview/05-governance-and-evolution.md)'
  do
    file_contains docs/overview/PRODUCT-OVERVIEW.md "$link" || {
      printf 'relative link check failed: docs/overview/PRODUCT-OVERVIEW.md\n' >&2
      return 1
    }
  done
}

check_json_cutover_state() {
  local path
  for path in \
    specs/repo/manifest.json \
    specs/repo/repository-structure.json \
    specs/repo/development-workflow.json \
    specs/repo/validation.json
  do
    file_contains "$path" '"status": "accepted"' || {
      printf 'cutover status check failed: %s\n' "$path" >&2
      return 1
    }
    if file_contains "$path" '"source_artifacts"'; then
      printf 'cutover source_artifacts check failed: %s\n' "$path" >&2
      return 1
    fi
  done
}

check_bootstrap_markdown_removed() {
  local path
  for path in \
    specs/repo/repo-specs-bootstrap.md \
    specs/repo/dev-workflow-bootstrap.md \
    specs/repo/validation.md
  do
    [[ -e $repo_root/$path ]] && {
      printf 'bootstrap markdown still present: %s\n' "$path" >&2
      return 1
    }
  done

  return 0
}

check_failure_exit_status() {
  if check_required_file '__bootstrap__/missing-file' >/dev/null 2>&1; then
    printf 'failure exit status check failed\n' >&2
    return 1
  fi
}

check_required_files || fail 'required files check failed'
printf 'ok: required files\n'

check_directory_separation || fail 'bootstrap directory separation violated'
printf 'ok: directory separation\n'

check_relative_links || fail 'relative link check failed'
printf 'ok: relative links\n'

check_json_cutover_state || fail 'cutover status/source_artifacts check failed'
printf 'ok: cutover state\n'

check_bootstrap_markdown_removed || fail 'bootstrap markdown removal check failed'
printf 'ok: bootstrap markdown removed\n'

check_failure_exit_status || fail 'failure exit status check failed'
printf 'ok: failure exit status\n'

exit 0
