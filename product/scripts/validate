#!/usr/bin/env python3
from pathlib import Path
import os
import subprocess
import sys

sys.dont_write_bytecode = True

ROOT = Path(__file__).resolve().parents[2]
ENV = os.environ.copy()
ENV["PYTHONDONTWRITEBYTECODE"] = "1"

raise SystemExit(
    subprocess.call(
        [sys.executable, str(ROOT / "product" / "validation" / "validate_product.py")],
        cwd=ROOT,
        env=ENV,
    )
)
