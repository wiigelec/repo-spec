{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product/schemas/product/product-level-1.schema.json",
  "title": "Product Level 1 Schema",
  "allOf": [
    {
      "$ref": "./product-spec-base.schema.json"
    },
    {
      "type": "object",
      "required": ["level", "primitives"],
      "properties": {
        "level": {
          "type": "integer",
          "const": 1
        },
        "primitives": {
          "type": "object",
          "additionalProperties": false,
          "required": ["concepts"],
          "properties": {
            "concepts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["destination_path", "type", "producer", "operation", "governing_spec", "mode", "required"],
            "properties": {
              "destination_path": {"type": "string", "minLength": 1},
              "type": {"type": "string", "enum": ["file", "directory", "tree"]},
              "producer": {"type": "string", "minLength": 1},
              "operation": {"type": "string", "minLength": 1},
              "governing_spec": {"type": "string", "minLength": 1},
              "mode": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"}
            }
          }
        },
        "prohibited_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "field_order": {
          "type": "object",
          "required": ["root"],
          "additionalProperties": false,
          "properties": {
            "root": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "repository": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "foundations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "material": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "stages": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "required",
        "deferrable",
        "recoverable",
        "predecessors",
        "output"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "deferrable": {
          "type": "boolean"
        },
        "recoverable": {
          "type": "boolean"
        },
        "predecessors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "output": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
