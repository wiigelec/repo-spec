{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product/schemas/product/product-level-1.schema.json",
  "title": "Product Level 1 Schema",
  "allOf": [
    {
      "$ref": "./product-spec-base.schema.json"
    },
    {
      "type": "object",
      "required": ["level", "primitives"],
      "properties": {
        "level": {
          "type": "integer",
          "const": 1
        },
        "primitives": {
          "type": "object",
          "additionalProperties": false,
          "required": ["concepts"],
          "properties": {
            "concepts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["destination_path", "type", "producer", "operation", "governing_spec", "mode", "required"],
            "properties": {
              "destination_path": {"type": "string", "minLength": 1},
              "type": {"type": "string", "enum": ["file", "directory", "tree"]},
              "producer": {"type": "string", "minLength": 1},
              "operation": {"type": "string", "minLength": 1},
              "governing_spec": {"type": "string", "minLength": 1},
              "mode": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"}
            }
          }
        },
        "fixed_worktree_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["destination_path", "producer", "operation", "governing_spec", "mode", "required"],
            "properties": {
              "destination_path": {"type": "string", "minLength": 1},
              "producer": {"type": "string", "minLength": 1},
              "operation": {"type": "string", "minLength": 1},
              "governing_spec": {"type": "string", "minLength": 1},
              "mode": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"}
            }
          }
        },
        "dynamic_path_families": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["producer", "rule", "expansion_pattern", "operation", "governing_spec", "type", "required"],
            "properties": {
              "producer": {"type": "string", "minLength": 1},
              "rule": {"type": "string", "minLength": 1},
              "expansion_pattern": {"type": "string", "minLength": 1},
              "operation": {"type": "string", "minLength": 1},
              "governing_spec": {"type": "string", "minLength": 1},
              "type": {"type": "string", "minLength": 1},
              "mode": {"type": "string"},
              "required": {"type": "boolean"}
            }
          }
        },
        "material_index": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["material_key", "destination_path", "producer", "operation", "mode", "required", "role"],
            "properties": {
              "material_key": {"type": "string", "minLength": 1},
              "destination_path": {"type": "string", "minLength": 1},
              "producer": {"type": "string", "minLength": 1},
              "operation": {"type": "string", "minLength": 1},
              "mode": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"},
              "role": {"type": "string", "minLength": 1}
            }
          }
        },
        "git_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["governing_specs", "rule"],
          "properties": {
            "governing_specs": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "rule": {"type": "string", "minLength": 1}
          }
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "classification", "order", "applies_to", "pass_condition", "failure_codes"],
            "properties": {
              "check_id": {"type": "string", "minLength": 1},
              "classification": {"type": "string", "enum": ["required", "advisory"]},
              "order": {"type": "integer", "minimum": 1},
              "applies_to": {"type": "string", "minLength": 1},
              "pass_condition": {"type": "string", "minLength": 1},
              "failure_codes": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "prohibited_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "path"],
            "additionalProperties": false,
            "properties": {
              "rule": {"type": "string", "enum": ["exact", "prefix"]},
              "path": {"type": "string", "minLength": 1}
            }
          }
        },
        "field_order": {
          "type": "object",
          "required": ["root"],
          "additionalProperties": false,
          "properties": {
            "root": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "repository": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "foundations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "material": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "stages": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "required",
        "deferrable",
        "recoverable",
        "predecessors",
        "output"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "deferrable": {
          "type": "boolean"
        },
        "recoverable": {
          "type": "boolean"
        },
        "predecessors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "output": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
