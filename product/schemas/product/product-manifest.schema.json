{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product/schemas/product/product-manifest.schema.json",
  "title": "Product Manifest Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_id",
    "title",
    "purpose",
    "status",
    "schema_version",
    "product_specifications"
  ],
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^product\\.manifest$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "accepted",
        "superseded",
        "retired"
      ]
    },
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "product_specifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/productSpecification"
      }
    }
  },
  "$defs": {
    "productSpecification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spec_id",
            "path",
            "status",
            "level"
          ],
          "properties": {
            "spec_id": {
              "type": "string",
              "pattern": "^product\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
            },
            "path": {
              "type": "string",
              "pattern": "^product/specs/product/level-0/(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.json$"
            },
            "status": {
              "type": "string",
              "enum": [
                "candidate",
                "accepted",
                "superseded",
                "retired"
              ]
            },
            "level": {
              "type": "integer",
              "const": 0
            },
            "capability_group": {
              "type": "string",
              "enum": [
                "initial-bounded-workflow",
                "future-extension"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spec_id",
            "path",
            "status",
            "level"
          ],
          "properties": {
            "spec_id": {
              "type": "string",
              "pattern": "^product\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
            },
            "path": {
              "type": "string",
              "pattern": "^product/specs/product/level-1/(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.json$"
            },
            "status": {
              "type": "string",
              "enum": [
                "candidate",
                "accepted",
                "superseded",
                "retired"
              ]
            },
            "level": {
              "type": "integer",
              "const": 1
            },
            "capability_group": {
              "type": "string",
              "enum": [
                "initial-bounded-workflow",
                "future-extension"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spec_id",
            "path",
            "status",
            "level"
          ],
          "properties": {
            "spec_id": {
              "type": "string",
              "pattern": "^product\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
            },
            "path": {
              "type": "string",
              "pattern": "^product/specs/product/level-2/(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.json$"
            },
            "status": {
              "type": "string",
              "enum": [
                "candidate",
                "accepted",
                "superseded",
                "retired"
              ]
            },
            "level": {
              "type": "integer",
              "const": 2
            },
            "capability_group": {
              "type": "string",
              "enum": [
                "initial-bounded-workflow",
                "future-extension"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spec_id",
            "path",
            "status",
            "level"
          ],
          "properties": {
            "spec_id": {
              "type": "string",
              "pattern": "^product\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
            },
            "path": {
              "type": "string",
              "pattern": "^product/specs/product/level-3/(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.json$"
            },
            "status": {
              "type": "string",
              "enum": [
                "candidate",
                "accepted",
                "superseded",
                "retired"
              ]
            },
            "level": {
              "type": "integer",
              "const": 3
            },
            "capability_group": {
              "type": "string",
              "enum": [
                "initial-bounded-workflow",
                "future-extension"
              ]
            }
          }
        }
      ]
    }
  }
}
