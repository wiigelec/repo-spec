{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product/schemas/product/product-spec-base.schema.json",
  "title": "Product Specification Base Schema",
  "type": "object",
  "required": [
    "spec_id",
    "title",
    "purpose",
    "status",
    "schema_version",
    "level",
    "normative_requirements",
    "dependencies",
    "references",
    "supersedes",
    "superseded_by",
    "derived_artifacts",
    "correspondence"
  ],
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^product\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "accepted",
        "superseded",
        "retired"
      ]
    },
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "level": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3
      ]
    },
    "normative_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/productSpecId"
      }
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/productSpecId"
      }
    },
    "derived_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derivedArtifact"
      }
    },
    "correspondence": {
      "$ref": "#/$defs/correspondence"
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_id"
      ],
      "properties": {
        "spec_id": {
          "type": "string",
          "pattern": "^product\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
        }
      }
    },
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "kind",
            "spec_id"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "specification"
            },
            "kind": {
              "type": "string",
              "enum": [
                "normative",
                "historical"
              ]
            },
            "spec_id": {
              "type": "string",
              "pattern": "^product\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "artifact"
            },
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$",
              "minLength": 1
            }
          }
        }
      ]
    },
    "derivedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "markdown"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^product/derived/specs/product/(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.md$"
        }
      }
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$",
      "minLength": 1
    },
    "requirementId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*-[0-9]+$"
    },
    "implementationId": {
      "type": "string",
      "pattern": "^impl\\.[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "testId": {
      "type": "string",
      "pattern": "^test\\.[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "implementationMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "paths",
        "requirements"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/implementationId"
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirementId"
          }
        }
      }
    },
    "testMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "paths",
        "requirements"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/testId"
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirementId"
          }
        }
      }
    },
    "conformanceRecord": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirement_id",
            "implementation_ids",
            "test_ids",
            "status"
          ],
          "properties": {
            "requirement_id": {
              "$ref": "#/$defs/requirementId"
            },
            "implementation_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/implementationId"
              }
            },
            "test_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/testId"
              }
            },
            "status": {
              "type": "string",
              "const": "covered"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirement_id",
            "implementation_ids",
            "test_ids",
            "status",
            "rationale"
          ],
          "properties": {
            "requirement_id": {
              "$ref": "#/$defs/requirementId"
            },
            "implementation_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/implementationId"
              }
            },
            "test_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/testId"
              }
            },
            "status": {
              "type": "string",
              "const": "not-applicable"
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "correspondence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementations",
        "tests",
        "conformance"
      ],
      "properties": {
        "implementations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/implementationMapping"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/testMapping"
          }
        },
        "conformance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conformanceRecord"
          }
        }
      }
    },
    "productSpecId": {
      "type": "string",
      "pattern": "^product\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
    }
  }
}
