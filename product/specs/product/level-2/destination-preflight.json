{
  "spec_id": "product.destination-preflight",
  "title": "Destination Preflight",
  "purpose": "Defines the destination preflight component that validates destination state compatibility before generation begins.",
  "status": "candidate",
  "schema_version": "1",
  "level": 2,
  "components": {
    "contracts": ["destination-preflight"]
  },
  "normative_requirements": [
    {
      "id": "INIT-DPF-001",
      "text": "The destination preflight component shall accept a destination representation, validate it against the declared existence constraint, and confirm that the destination is in a state compatible with the requested initialization operation."
    },
    {
      "id": "INIT-DPF-002",
      "text": "The destination preflight component shall reject a destination that already exists in a conflicting state and shall report the conflict without modifying the destination."
    }
  ],
