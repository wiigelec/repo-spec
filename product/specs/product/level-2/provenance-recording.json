{
  "spec_id": "product.provenance-recording",
  "title": "Provenance Recording",
  "purpose": "Defines the provenance recording component that captures and writes provenance data to the initialized repository.",
  "status": "accepted",
  "schema_version": "1",
  "level": 2,
  "components": {
    "contracts": [
      "provenance-recording"
    ]
  },
  "normative_requirements": [
    {
      "id": "INIT-PRC-001",
      "text": "The provenance recording component shall capture initializer identity/version, the resolved local repo-spec framework repository and exact framework revision actually used for material installation, the immutable bootstrap request fingerprint, and initialization timestamp, and shall write that provenance record into the staged repository before Git initialization and validation."
    },
    {
      "id": "INIT-PRC-002",
      "text": "Provenance recording shall not require or emit product identity, direction material, or a separately supplied initialization-authority identifier."
    }
  ],
