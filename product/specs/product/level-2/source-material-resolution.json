{
  "spec_id": "product.source-material-resolution",
  "title": "Local Source Material Selection",
  "purpose": "Defines selection and inventory of framework material from an explicit revision in a local source repository.",
  "status": "candidate",
  "schema_version": "1",
  "level": 2,
  "components": {
    "contracts": [
      "source-material-resolution"
    ]
  },
  "normative_requirements": [
    {
      "id": "INIT-SMR-001",
      "text": "The local source material component shall verify that the explicit revision exists in the supplied local source repository, read material only from that revision, inventory the available framework material, and classify each material item by role."
    },
    {
      "id": "INIT-SMR-002",
      "text": "The component shall reject an unavailable exact revision without resolving a named reference, contacting a remote source, or retrieving additional source material."
    }
  ],
