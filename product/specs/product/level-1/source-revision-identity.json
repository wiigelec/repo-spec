  "normative_requirements": [
    {
      "id": "INIT-SRC-001",
      "text": "A source revision identity shall be an atomic reference that uniquely identifies the exact revision of the initializer's reusable framework material."
    },
    {
      "id": "INIT-SRC-002",
      "text": "The source revision identity shall support both a concrete pinned revision and a resolvable named reference, and the resolved identity shall be recorded in the provenance record."
    }
