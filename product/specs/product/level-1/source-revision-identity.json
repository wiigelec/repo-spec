{
  "spec_id": "product.source-revision-identity",
  "title": "Source Revision Identity",
  "purpose": "Defines the atomic source revision identity reference for the initializer's reusable framework material.",
  "status": "candidate",
  "schema_version": "1",
  "level": 1,
