{
  "spec_id": "product.destination",
  "title": "Destination Contract",
  "purpose": "Defines the absent-or-empty local destination for the bounded initialization workflow.",
  "status": "candidate",
  "schema_version": "1",
  "level": 1,
  "primitives": {
    "concepts": ["destination-representation"]
  },
  "normative_requirements": [
    {
      "id": "INIT-DST-001",
      "text": "A destination representation shall be a local filesystem path whose target is absent or is an empty directory."
    },
    {
      "id": "INIT-DST-002",
      "text": "Destination validation shall occur before generation and shall reject non-directory targets, nonempty directories, existing repositories, and any request to overwrite or migrate destination content."
    }
  ],
