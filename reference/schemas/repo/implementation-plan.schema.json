{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/repo/implementation-plan.schema.json",
  "title": "Implementation Plan Document Schema",
  "allOf": [
    {"$ref": "./development-document-base.schema.json"},
    {
      "type": "object",
      "required": ["artifact_type", "root_path"],
      "properties": {
        "artifact_type": {"type": "string", "const": "implementation-plan"},
        "root_path": {"type": "string", "const": "docs/plans/"}
      }
    }
  ],
  "unevaluatedProperties": false
}
