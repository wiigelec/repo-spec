{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference Repository Spec Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_id",
    "title",
    "purpose",
    "status",
    "schema_version",
    "normative_requirements"
  ],
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^repo\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["candidate", "accepted", "superseded", "retired"]
    },
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "issue_fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "review_fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "artifact_classes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactClass"
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "normative_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "derived_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derivedArtifact"
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "required", "input_type", "description", "placeholder"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "input_type": {
          "type": "string",
          "enum": ["input", "textarea"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "placeholder": {
          "type": "string",
          "minLength": 1
        },
        "validation": {
          "$ref": "#/$defs/validation"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["meaningful", "issue-link", "spec-reference", "numbered-steps", "default-branch-base"]
        },
        "allow_none": {
          "type": "boolean"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifactClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "label"],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "authority_category": {
          "type": "string",
          "minLength": 1
        },
        "authority_source": {
          "type": "string",
          "minLength": 1
        },
        "source_of_truth_rule": {
          "type": "string",
          "minLength": 1
        },
        "mutability": {
          "type": "string",
          "minLength": 1
        },
        "generation_mode": {
          "type": "string",
          "enum": ["manual", "deterministic", "external"]
        },
        "validation_ownership": {
          "type": "string",
          "minLength": 1
        },
        "portability_category": {
          "type": "string",
          "minLength": 1
        },
        "manifest_participation": {
          "type": "string",
          "minLength": 1
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "label",
        "source_root",
        "installed_adapter_root",
        "authority_boundary",
        "adapter_generation_policy",
        "artifact_inventory",
        "deployment_state",
        "remote_state_kinds",
        "mutation_record_fields"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "source_root": {
          "type": "string",
          "minLength": 1
        },
        "installed_adapter_root": {
          "type": "string",
          "minLength": 1
        },
        "authority_boundary": {
          "type": "string",
          "minLength": 1
        },
        "adapter_generation_policy": {
          "type": "string",
          "minLength": 1
        },
        "artifact_inventory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactInventoryItem"
          }
        },
        "deployment_state": {
          "type": "object"
        },
        "remote_state_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mutation_record_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifactInventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "classification", "authority_category", "profile_id"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "authority_category": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_id"],
      "properties": {
        "spec_id": {
          "type": "string",
          "pattern": "^repo\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
        }
      }
    },
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "spec_id"],
          "properties": {
            "type": {
              "type": "string",
              "const": "specification"
            },
            "kind": {
              "type": "string",
              "enum": ["normative", "historical"]
            },
            "spec_id": {
              "type": "string",
              "pattern": "^repo\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": {
              "type": "string",
              "const": "artifact"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "derivedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["markdown", "yaml"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "renderer": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
