{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference Product Spec Base Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_id",
    "title",
    "purpose",
    "status",
    "schema_version",
    "level",
    "normative_requirements",
    "dependencies",
    "references",
    "supersedes",
    "superseded_by",
    "derived_artifacts",
    "correspondence"
  ],
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^product\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["candidate", "accepted", "superseded", "retired"]
    },
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "level": {
      "type": "integer",
      "enum": [0, 1]
    },
    "normative_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "derived_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derivedArtifact"
      }
    },
    "correspondence": {
      "$ref": "#/$defs/correspondence"
    },
    "kernel": {
      "$ref": "#/$defs/kernel"
    },
    "primitives": {
      "$ref": "#/$defs/primitives"
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_id"],
      "properties": {
        "spec_id": {
          "type": "string",
          "pattern": "^product\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
        }
      }
    },
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "spec_id"],
          "properties": {
            "type": {
              "type": "string",
              "const": "specification"
            },
            "kind": {
              "type": "string",
              "enum": ["normative", "historical"]
            },
            "spec_id": {
              "type": "string",
              "pattern": "^product\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": {
              "type": "string",
              "const": "artifact"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "derivedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["markdown"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paths", "requirements"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "conformanceRecord": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["requirement_id", "implementation_ids", "test_ids", "status"],
          "properties": {
            "requirement_id": {
              "type": "string",
              "minLength": 1
            },
            "implementation_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "test_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "status": {
              "type": "string",
              "const": "covered"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["requirement_id", "implementation_ids", "test_ids", "status", "rationale"],
          "properties": {
            "requirement_id": {
              "type": "string",
              "minLength": 1
            },
            "implementation_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "test_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "status": {
              "type": "string",
              "const": "not-applicable"
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "correspondence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementations", "tests", "conformance"],
      "properties": {
        "implementations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mapping"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mapping"
          }
        },
        "conformance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conformanceRecord"
          }
        }
      }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foundations"],
      "properties": {
        "foundations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "primitives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concepts"],
      "properties": {
        "concepts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
