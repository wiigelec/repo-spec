{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference Product Level 0 Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_id",
    "title",
    "purpose",
    "status",
    "schema_version",
    "level",
    "normative_requirements",
    "dependencies",
    "references",
    "supersedes",
    "superseded_by",
    "derived_artifacts",
    "correspondence"
  ],
  "properties": {
    "spec_id": {
      "type": "string",
      "const": "product.kernel"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["candidate", "accepted", "superseded", "retired"]
    },
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "level": {
      "type": "integer",
      "const": 0
    },
    "normative_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spec_id"],
        "properties": {
          "spec_id": {"type": "string", "const": "product.kernel"}
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path"],
            "properties": {
              "type": {"type": "string", "const": "artifact"},
              "path": {"type": "string", "minLength": 1}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "spec_id"],
            "properties": {
              "type": {"type": "string", "const": "specification"},
              "kind": {"type": "string", "enum": ["normative", "historical"]},
              "spec_id": {"type": "string", "minLength": 1}
            }
          }
        ]
      }
    },
    "supersedes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "superseded_by": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "derived_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path"],
        "properties": {
          "type": {"type": "string", "const": "markdown"},
          "path": {"type": "string", "minLength": 1}
        }
      }
    },
    "correspondence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementations", "tests", "conformance"],
      "properties": {
        "implementations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "paths", "requirements"],
            "properties": {
              "id": {"type": "string", "const": "kernel-impl"},
              "paths": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "requirements": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "paths", "requirements"],
            "properties": {
              "id": {"type": "string", "const": "kernel-test"},
              "paths": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "requirements": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "conformance": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirement_id", "implementation_ids", "test_ids", "status"],
            "properties": {
              "requirement_id": {"type": "string", "const": "REF-KERNEL-001"},
              "implementation_ids": {
                "type": "array",
                "items": {"type": "string", "const": "kernel-impl"}
              },
              "test_ids": {
                "type": "array",
                "items": {"type": "string", "const": "kernel-test"}
              },
              "status": {"type": "string", "const": "covered"}
            }
          }
        }
      }
    }
  }
}
