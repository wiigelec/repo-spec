{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference Product Manifest Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_id",
    "title",
    "purpose",
    "status",
    "schema_version",
    "product_specifications"
  ],
  "properties": {
    "spec_id": {
      "type": "string",
      "const": "product.manifest"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["candidate", "accepted", "superseded", "retired"]
    },
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "product_specifications": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["spec_id", "path", "status", "level"],
            "properties": {
              "spec_id": {
                "type": "string",
                "const": "product.kernel"
              },
              "path": {
                "type": "string",
                "const": "specs/product/level-0/kernel.json"
              },
              "status": {
                "type": "string",
                "enum": ["accepted"]
              },
              "level": {
                "type": "integer",
                "const": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["spec_id", "path", "status", "level"],
            "properties": {
              "spec_id": {
                "type": "string",
                "const": "product.primitives"
              },
              "path": {
                "type": "string",
                "const": "specs/product/level-1/primitives.json"
              },
              "status": {
                "type": "string",
                "enum": ["accepted"]
              },
              "level": {
                "type": "integer",
                "const": 1
              }
            }
          }
        ]
      }
    }
  }
}
