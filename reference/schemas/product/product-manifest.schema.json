{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference Product Manifest Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_id",
    "title",
    "purpose",
    "status",
    "schema_version",
    "product_specifications"
  ],
  "properties": {
    "spec_id": {
      "type": "string",
      "const": "product.manifest"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["candidate", "accepted", "superseded", "retired"]
    },
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "product_specifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/productSpecification"
      }
    }
  },
  "$defs": {
    "productSpecification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["spec_id", "path", "status", "level"],
          "properties": {
            "spec_id": {
              "type": "string",
              "pattern": "^product\\.[A-Za-z0-9._-]+$"
            },
            "path": {
              "type": "string",
              "pattern": "^specs/product/level-0/(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.json$"
            },
            "status": {
              "type": "string",
              "enum": ["candidate", "accepted", "superseded", "retired"]
            },
            "level": {
              "type": "integer",
              "const": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["spec_id", "path", "status", "level"],
          "properties": {
            "spec_id": {
              "type": "string",
              "pattern": "^product\\.[A-Za-z0-9._-]+$"
            },
            "path": {
              "type": "string",
              "pattern": "^specs/product/level-1/(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.json$"
            },
            "status": {
              "type": "string",
              "enum": ["candidate", "accepted", "superseded", "retired"]
            },
            "level": {
              "type": "integer",
              "const": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["spec_id", "path", "status", "level"],
          "properties": {
            "spec_id": {
              "type": "string",
              "pattern": "^product\\.[A-Za-z0-9._-]+$"
            },
            "path": {
              "type": "string",
              "pattern": "^specs/product/level-2/(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.json$"
            },
            "status": {
              "type": "string",
              "enum": ["candidate", "accepted", "superseded", "retired"]
            },
            "level": {
              "type": "integer",
              "const": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["spec_id", "path", "status", "level"],
          "properties": {
            "spec_id": {
              "type": "string",
              "pattern": "^product\\.[A-Za-z0-9._-]+$"
            },
            "path": {
              "type": "string",
              "pattern": "^specs/product/level-3/(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.json$"
            },
            "status": {
              "type": "string",
              "enum": ["candidate", "accepted", "superseded", "retired"]
            },
            "level": {
              "type": "integer",
              "const": 3
            }
          }
        }
      ]
    }
  }
}
